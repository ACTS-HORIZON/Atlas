# Atlas configuration. Copy to atlas.env (gitignored) and edit.
# Read by `npm start` (body/src/config.js) and by the systemd unit (EnvironmentFile).
# Real environment variables override this file.

# Minecraft server (offline mode). On the atlas LXC the server is local.
ATLAS_MC_HOST=localhost
ATLAS_MC_PORT=25565
ATLAS_USERNAME=Atlas
# Protocol version; empty = ask the server. Set it if auto-detection misbehaves.
ATLAS_MC_VERSION=

# The link (WebSocket) the mind connects to. Keep it on loopback.
ATLAS_LINK_HOST=127.0.0.1
ATLAS_LINK_PORT=8765

# Contract-message logs (JSONL), relative to the repo root or absolute.
ATLAS_LOG_DIR=logs

# Periodic full-view obs interval, ms.
ATLAS_OBS_INTERVAL_MS=2000

# sight_radius (CONTRACT.md, "Sight"): max sight distance in blocks, default 64. The effective radius is also capped by the
# render distance: min(server view-distance, the bot's client view distance)
# x 16. The bot asks for ceil(ATLAS_SIGHT_RADIUS / 16) chunks.
ATLAS_SIGHT_RADIUS=64

# Known places (CONTRACT.md, "Known places"): every notable block Atlas has
# seen, persisted and reloaded on start. By default the file is named after
# the server, data/known-places.<host>_<port>.json, so two servers never share
# one. Set this only to override that (relative to the repo root or absolute).
#ATLAS_PLACES_FILE=data/known-places.custom.json

# Dashboard (read-only view of the link + one Stop button). host:port, or
# "off" to disable. No authentication: anyone who can reach it can watch and
# press Stop. Use 127.0.0.1:8080 to keep it local to the LXC.
ATLAS_DASH_BIND=0.0.0.0:8080

# Live-written verb library (listed on the dashboard).
ATLAS_VERB_DIR=data/verbs

# mine: strip-mining when no target is in view. Straight length before a
# turn (branch-mine serpentine), and the total tunnel length cap.
ATLAS_STRIP_LENGTH=24
ATLAS_STRIP_MAX=256

# Players whose chat Atlas listens to (comma-separated). "@Atlas stop",
# "@Atlas status" and "@Atlas come here" are handled by the body; other
# "@Atlas ..." becomes a task for the mind. Empty: nobody.
ATLAS_PLAYERS=

# House rules: protected regions, never dug or built in (JSON list of boxes;
# "dim" optional). Empty: none.
# ATLAS_PROTECTED_REGIONS=[{"name":"spawn","dim":"overworld","from":[-20,50,-20],"to":[20,120,20]}]
ATLAS_PROTECTED_REGIONS=
